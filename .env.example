# Copy to .env — never commit real values.

# Runtime DB — Supabase Session pooler (port 5432) or local Postgres.
# Copy the exact host and username from Supabase Connect; encode the password.
# Hosted example: postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg://chargebackos:chargebackos@127.0.0.1:5432/chargebackos

# Alembic — direct connection where IPv6 works, or Session pooler on IPv4.
# Never use Transaction pooler (6543) for migrations. Blank reuses DATABASE_URL.
# DATABASE_URL_DIRECT=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require

# FastAPI signing secret (long random string)
AUTH_SECRET=change-me-to-a-long-random-string

# Seeded demo staff password (all four roles). Change before hosting.
DEMO_PASSWORD=change-me-demo

# Public API origin the website should call (local default)
VITE_API_URL=http://127.0.0.1:8000
API_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Optional LLM rewrite — product works without this
# XAI_API_KEY=

# Render / Vercel
# WEB_ORIGIN=https://your-app.vercel.app
