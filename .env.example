# Copy to .env — never commit real values.

# Runtime DB — Neon pooled string (host contains -pooler) or local Postgres.
# Example Neon: postgresql://USER:PASS@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+psycopg://chargebackos:chargebackos@127.0.0.1:5432/chargebackos

# Alembic / schema changes — Neon *direct* string (no -pooler). Leave blank to reuse DATABASE_URL.
# DATABASE_URL_DIRECT=postgresql://USER:PASS@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# FastAPI signing secret (long random string)
AUTH_SECRET=change-me-to-a-long-random-string

# Seeded demo staff password (all four roles). Change before hosting.
DEMO_PASSWORD=change-me-demo

# Public API origin the website should call (local default)
VITE_API_URL=http://127.0.0.1:8000
API_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Optional LLM rewrite — product works without this
# XAI_API_KEY=

# Render / Vercel
# WEB_ORIGIN=https://your-app.vercel.app
